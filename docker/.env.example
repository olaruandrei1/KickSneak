# Postgres
POSTGRES_DB=kicksneak
POSTGRES_USER=kicksneak_user
POSTGRES_PASSWORD=your_password_here

# RBAC roles
KS_OWNER_PASSWORD=your_password_here
KS_CHAT_PASSWORD=your_password_here
KS_ADMIN_PASSWORD=your_password_here

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase (base64 encoded firebase-config.json)
# Generate: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("firebase-config.json")) | Set-Clipboard
FIREBASE_CREDENTIALS_B64=base64_here